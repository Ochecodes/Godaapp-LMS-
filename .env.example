NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase secret key. Required for distributed rate limiting and admin operations.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Temporary legacy fallback; remove after migrating to SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only Payload/Postgres connection string.
DATABASE_URI=postgresql://user:password@host:5432/postgres?sslmode=require

PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public canonical website URL used by generated sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# Server-side public app URL used by Bachs checkout and admin workflows.
APP_BASE_URL=https://your-production-domain.example

# Bachs API credentials used to create checkout sessions and verify webhooks.
BACHS_API_KEY=sk_sandbox_your_key_here
BACHS_WEBHOOK_SECRET=replace-with-your-bachs-webhook-secret

# Tinybird analytics credentials; keep server-side and never expose in client bundles.
TINYBIRD_API_KEY=your-tinybird-api-token
TINYBIRD_URL=https://api.tinybird.co
TINYBIRD_ANALYTICS_DATASOURCE=godaapp_events

# Public Sentry event-ingestion DSN; not an authentication credential.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN override and source-map upload credentials.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
